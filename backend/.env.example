# ============================================================
# DAPAWORK — Environment Variables
# ============================================================
# Salin file ini sebagai .env dan .env.local di folder frontend/
# JANGAN commit file .env ke Git!
# ============================================================

# ── SUPABASE (wajib) ────────────────────────────────────────
# Dapatkan dari: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AI SERVER (OpenAI-compatible) ───────────────────────────
# URL base API server OpenAI-compatible Anda (tanpa /chat/completions)
AI_SERVER_URL=https://api.your-ai-server.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini

# ── FRONTEND (Vite — prefix VITE_) ──────────────────────────
# Variabel ini di-expose ke browser, jangan taruh secret!
# Letakkan file .env.local ini di folder frontend/
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_BASE_URL=https://your-app.vercel.app

# ── VERCEL SECRET NAMES ─────────────────────────────────────
# Setelah deploy ke Vercel, tambahkan secrets ini via:
# vercel env add SUPABASE_URL production
# vercel env add SUPABASE_SERVICE_ROLE_KEY production
# vercel env add AI_SERVER_URL production
# vercel env add AI_API_KEY production
